corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_gameover_bg"]
bg_color = Color(0.05, 0.02, 0.02, 0.92)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="MarginContainer" type="MarginContainer" parent="."]
offset_left = 12.0
offset_top = 10.0
offset_right = 260.0
offset_bottom = 105.0

[node name="Panel" type="PanelContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_bg")

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer/Panel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="PlayerHPLabel" type="Label" parent="MarginContainer/Panel/VBoxContainer"]
layout_mode = 2
text = "HP: 5 / 5   ♥ ♥ ♥ ♥ ♥"

[node name="LivesLabel" type="Label" parent="MarginContainer/Panel/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)
text = "Lives: ♥ ♥ ♥"

[node name="DemonContainer" type="VBoxContainer" parent="MarginContainer/Panel/VBoxContainer"]
visible = false
layout_mode = 2

[node name="DemonHPLabel" type="Label" parent="MarginContainer/Panel/VBoxContainer/DemonContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.3, 0.3, 1)
text = "DEMON: 5 / 5"

[node name="DemonHPBar" type="ProgressBar" parent="MarginContainer/Panel/VBoxContainer/DemonContainer"]
custom_minimum_size = Vector2(180, 10)
layout_mode = 2
theme_override_styles/background = SubResource("StyleBoxFlat_bar_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_bar_fill")
max_value = 5.0
value = 5.0
show_percentage = false

[node name="BannerLabel" type="Label" parent="."]
visible = false
anchors_preset = 10
anchor_right = 1.0
offset_top = 60.0
offset_bottom = 90.0
grow_horizontal = 2
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.8)
theme_override_font_sizes/font_size = 18
text = "COMBAT STARTED - ARENA LOCKED!"
horizontal_alignment = 1
vertical_alignment = 1

[node name="GameOverPanel" type="Panel" parent="."]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_styles/panel = SubResource("StyleBoxFlat_gameover_bg")

[node name="VBoxContainer" type="VBoxContainer" parent="GameOverPanel"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -150.0
offset_top = -70.0
offset_right = 150.0
offset_bottom = 70.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16
alignment = 1

[node name="TitleLabel" type="Label" parent="GameOverPanel/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.15, 0.15, 1)
theme_override_font_sizes/font_size = 36
text = "GAME OVER"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="GameOverPanel/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.75, 0.75, 1)
theme_override_font_sizes/font_size = 16
text = "You have fallen."
horizontal_alignment = 1

[node name="RetryLabel" type="Label" parent="GameOverPanel/VBoxContainer"]
layout_mode = 2
